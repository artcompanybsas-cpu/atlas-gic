# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Market Data APIs
FMP_API_KEY=your_fmp_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
POLYGON_API_KEY=your_polygon_api_key_here
FRED_API_KEY=your_fred_api_key_here

# Portfolio Settings
STARTING_CAPITAL=1000000
MAX_POSITION_SIZE_PCT=0.15
MAX_GROSS_EXPOSURE=1.5
MAX_NET_EXPOSURE=0.8

# Autoresearch Settings
AUTORESEARCH_WINDOW_DAYS=5
AUTORESEARCH_MIN_RECOMMENDATIONS=10
DARWINIAN_WEIGHT_CEILING=2.5
DARWINIAN_WEIGHT_FLOOR=0.3
DARWINIAN_REWARD_MULTIPLIER=1.05
DARWINIAN_PENALTY_MULTIPLIER=0.95

# LLM Settings
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# Paths
DATA_DIR=src/data
PROMPTS_DIR=src/prompts
LOG_DIR=logs
